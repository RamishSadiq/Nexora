+import React, { useEffect, useState } from "react";
+import { useRouter } from "next/router";
+
+export default function PortalLoginPage() {
+  const [providers, setProviders] = useState<Array<{ id: string; name: string }>>([]);
+  const router = useRouter();
+
+  useEffect(() => {
+    fetch("/api/v1/providers")
+      .then(r => r.json())
+      .then(setProviders);
+  }, []);
+
+  const startLogin = (id: string) => {
+    if (id === "entra") {
+      // OIDC challenge
+      router.push("/login/entra");
+    } else {
+      // fallback to local dev login page
+      router.push("/login");
+    }
+  };
+
+  return (
+    <div className="flex flex-col items-center py-12">
+      <h1 className="text-2xl font-bold mb-6">Sign in to Nexora Portal</h1>
+      {providers.map(p => (
+        <button
+          key={p.id}
+          className="bg-blue-600 text-white py-2 px-4 rounded mb-3 w-60"
+          onClick={() => startLogin(p.id)}
+        >
+          Continue with {p.name}
+        </button>
+      ))}
+    </div>
+  );
+}
