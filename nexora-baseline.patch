+    // -------------------------------------------------
+    // NEW: Secure assistant endpoint – runs through normal policy
+    // -------------------------------------------------
+    endpoints.MapGet("/api/v1/assistant/crm-context", async ctx =>
+    {
+        var token = ctx.Request.Query["token"];
+        if (!AssistantTokenValidator.IsValid(token, out var tenantId, out var expiry))
+        {
+            ctx.Response.StatusCode = StatusCodes.Status401Unauthorized;
+            return;
+        }
+
+        // Build a minimal service‑principal that only has crm.read
+        var servicePrincipal = new ClaimsPrincipal(new ClaimsIdentity(new[]
+        {
+            new Claim(ClaimTypes.NameIdentifier, "assistant-service"),
+            new Claim(NexoraClaims.TenantId, tenantId),
+            new Claim(NexoraClaims.Permission, "crm.read")
+        }, "AssistantToken"));
+
+        var authz = await ctx.RequestServices
+            .GetRequiredService<IAuthorizationService>()
+            .AuthorizeAsync(servicePrincipal, null, "CrmReadPolicy");
+
+        if (!authz.Succeeded)
+        {
+            ctx.Response.StatusCode = StatusCodes.Status403Forbidden;
+            return;
+        }
+
+        var directory = ctx.RequestServices.GetRequiredService<ICrmDirectory>();
+        var records = await directory.GetAllAsync(tenantId);
+        await ctx.Response.WriteAsJsonAsync(records);
+    })
+    .RequireAuthorization(); // still passes through the global auth middleware
+
+    // -------------------------------------------------
+    // NEW: Light‑weight overview endpoint (used by staff UI & assistant)
+    // -------------------------------------------------
+    endpoints.MapGet("/records/{id:guid}/overview", async ctx =>
+    {
+        var user = ctx.User;
+        var tenantId = user.FindFirst(NexoraClaims.TenantId)?.Value;
+        if (string.IsNullOrEmpty(tenantId))
+        {
+            ctx.Response.StatusCode = StatusCodes.Status401Unauthorized;
+            return;
+        }
+
+        var authz = await ctx.RequestServices
+            .GetRequiredService<IAuthorizationService>()
+            .AuthorizeAsync(user, null, "CrmReadPolicy");
+
+        if (!authz.Succeeded)
+        {
+            ctx.Response.StatusCode = StatusCodes.Status403Forbidden;
+            return;
+        }
+
+        var directory = ctx.RequestServices.GetRequiredService<ICrmDirectory>();
+        var record = await directory.GetAsync(tenantId, ctx.GetRouteValue("id")!.ToString()!);
+        if (record == null)
+        {
+            ctx.Response.StatusCode = StatusCodes.Status404NotFound;
+            return;
+        }
+
+        var overview = new
+        {
+            Id = record.Id,
+            Kind = record.Kind,
+            Name = record.Name,
+            IsActive = record.IsActive,
+            AllowedActions = new[]
+            {
+                new { Name = "Edit",    Url = $"/records/{record.Id}/edit" },
+                new { Name = "Archive", Url = $"/records/{record.Id}/archive" },
+                new { Name = "Timeline",Url = $"/records/{record.Id}/timeline" }
+            },
+            TimelineUrl = $"/records/{record.Id}/timeline"
+        };
+
+        await ctx.Response.WriteAsJsonAsync(overview);
+    })
+    .RequireAuthorization("CrmReadPolicy");
