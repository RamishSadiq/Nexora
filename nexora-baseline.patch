+import React, { useEffect, useState } from "react";
+
+type ProfileDto = {
+  preferredName?: string;
+  phone?: string;
+  address?: string;
+};
+
+export default function MyProfile() {
+  const [profile, setProfile] = useState<ProfileDto | null>(null);
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  // -----------------------------------------------------------------
+  // Load current profile (GET /api/v1/portal/me/profile)
+  // -----------------------------------------------------------------
+  useEffect(() => {
+    fetch("/api/v1/portal/me/profile")
+      .then(r => r.ok ? r.json() : Promise.reject("Unable to load profile"))
+      .then(setProfile)
+      .catch(setError);
+  }, []);
+
+  // -----------------------------------------------------------------
+  // Save profile (PATCH /api/v1/portal/me/profile)
+  // -----------------------------------------------------------------
+  const save = async () => {
+    if (!profile) return;
+    setSaving(true);
+    setError(null);
+    try {
+      const resp = await fetch("/api/v1/portal/me/profile", {
+        method: "PATCH",
+        headers: { "Content-Type": "application/json", "If-Match": "*" },
+        body: JSON.stringify(profile),
+      });
+      if (!resp.ok) throw new Error(`Save failed: ${resp.status}`);
+      const updated = await resp.json();
+      setProfile(updated);
+    } catch (e: any) {
+      setError(e.message);
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  if (error) return <div className="text-red-600">Error: {error}</div>;
+  if (!profile) return <div>Loading…</div>;
+
+  return (
+    <div className="max-w-lg mx-auto py-8">
+      <h2 className="text-xl font-semibold mb-4">My profile</h2>
+
+      <label className="block mb-2">
+        Preferred name
+        <input
+          className="border rounded w-full p-1"
+          value={profile.preferredName ?? ""}
+          onChange={e => setProfile({ ...profile, preferredName: e.target.value })}
+        />
+      </label>
+
+      <label className="block mb-2">
+        Phone
+        <input
+          className="border rounded w-full p-1"
+          value={profile.phone ?? ""}
+          onChange={e => setProfile({ ...profile, phone: e.target.value })}
+        />
+      </label>
+
+      <label className="block mb-2">
+        Address
+        <textarea
+          className="border rounded w-full p-1"
+          value={profile.address ?? ""}
+          onChange={e => setProfile({ ...profile, address: e.target.value })}
+        />
+      </label>
+
+      <button
+        className="bg-green-600 text-white py-2 px-4 rounded mt-4"
+        onClick={save}
+        disabled={saving}
+      >
+        {saving ? "Saving…" : "Save changes"}
+      </button>
+    </div>
+  );
+}
