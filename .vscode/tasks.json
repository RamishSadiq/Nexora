{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "local-ensure-api",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/Prepare-LocalDebug.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "local-build-api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/backend/src/Nexora.Api",
        "--configuration",
        "LocalDebug",
        "-p:DebugSymbols=true",
        "-p:DebugType=portable",
        "-p:Optimize=false",
        "-m:1",
        "-nr:false",
        "-p:UseSharedCompilation=false"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "local-wait-api",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/Prepare-LocalDebug.ps1",
        "-WaitForApi"
      ],
      "problemMatcher": []
    },
    {
      "label": "local-ensure-api-crm",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/Prepare-LocalDebug.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "local-ensure-api-portal",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/Prepare-LocalDebug.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "local-ensure-api-cms",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/Prepare-LocalDebug.ps1"
      ],
      "problemMatcher": []
    }
  ]
}
