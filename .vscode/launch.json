{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nexora API",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/Nexora.Api/bin/Debug/net10.0/Nexora.Api.exe",
      "cwd": "${workspaceFolder}/backend/src/Nexora.Api",
      "args": [
        "--urls",
        "http://localhost:5081"
      ],
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Identity__SeedAdminPassword": "Nexora-Local-2026!",
        "Identity__ResetSeedAdminPassword": "true",
        "ConnectionStrings__Nexora": "Server=.\\SQLEXPRESS;Database=NexoraDev;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
      },
      "preLaunchTask": "free-api-port"
    },
    {
      "name": "Nexora Web",
      "type": "node-terminal",
      "request": "launch",
      "command": "C:/Users/ramish/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node.exe node_modules/next/dist/bin/next dev --webpack",
      "cwd": "${workspaceFolder}/apps/web",
      "args": [
        "--port",
        "3000"
      ],
      "env": {
        "NEXORA_API_URL": "http://localhost:5081"
      },
      "preLaunchTask": "free-web-port",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "- Local:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Website API (LocalDB)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/Nexora.Api/bin/WebsiteDebug/net10.0/Nexora.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/Nexora.Api",
      "args": [
        "--urls",
        "http://localhost:5097"
      ],
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "ConnectionStrings__Nexora": "Server=(localdb)\\MSSQLLocalDB;Database=NexoraDev;Trusted_Connection=True;TrustServerCertificate=True",
        "Web__AllowedOrigins__0": "http://localhost:3017",
        "Identity__ResetSeedAdminPassword": "false"
      },
      "justMyCode": true
    },
    {
      "name": "Website Web (source + browser)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "C:/Users/ramish/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node.exe",
      "program": "${workspaceFolder}/apps/web/node_modules/next/dist/bin/next",
      "cwd": "${workspaceFolder}/apps/web",
      "args": [
        "dev",
        "--webpack",
        "--port",
        "3017"
      ],
      "env": {
        "NEXORA_API_URL": "http://localhost:5097",
        "NEXORA_NEXT_DIST_DIR": ".next-website-debug"
      },
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "website-wait-api",
      "serverReadyAction": {
        "action": "debugWithEdge",
        "killOnServerStop": true,
        "pattern": "- Local:\\s+(https?://\\S+)",
        "uriFormat": "%s/site/513f76cf-4cae-40aa-8812-0d9de03c6285/home",
        "webRoot": "${workspaceFolder}/apps/web"
      }
    },
    {
      "name": "Portal Web (source + browser)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "C:/Users/ramish/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node.exe",
      "program": "${workspaceFolder}/apps/web/node_modules/next/dist/bin/next",
      "cwd": "${workspaceFolder}/apps/web",
      "args": [
        "dev",
        "--webpack",
        "--port",
        "3017"
      ],
      "env": {
        "NEXORA_API_URL": "http://localhost:5097",
        "NEXORA_NEXT_DIST_DIR": ".next-website-debug"
      },
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "website-wait-api",
      "serverReadyAction": {
        "action": "debugWithEdge",
        "killOnServerStop": true,
        "pattern": "- Local:\\s+(https?://\\S+)",
        "uriFormat": "%s/portal",
        "webRoot": "${workspaceFolder}/apps/web"
      }
    }
  ],
  "compounds": [
    {
      "name": "Portal (API + Web)",
      "configurations": [
        "Website API (LocalDB)",
        "Portal Web (source + browser)"
      ],
      "preLaunchTask": "website-prepare",
      "stopAll": true
    },
    {
      "name": "Website (API + Web)",
      "configurations": [
        "Website API (LocalDB)",
        "Website Web (source + browser)"
      ],
      "preLaunchTask": "website-prepare",
      "stopAll": true
    },
    {
      "name": "Nexora (API + Web)",
      "configurations": [
        "Nexora API",
        "Nexora Web"
      ],
      "stopAll": true
    }
  ]
}
