{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nexora shared API",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/Nexora.Api/bin/LocalDebug/net10.0/Nexora.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/Nexora.Api",
      "args": [
        "--urls",
        "http://localhost:5097"
      ],
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "ConnectionStrings__Nexora": "Server=.\\SQLEXPRESS;Database=NexoraDev;Trusted_Connection=True;TrustServerCertificate=True",
        "Web__AllowedOrigins__0": "http://localhost:3017",
        "Web__AllowedOrigins__1": "http://localhost:3018",
        "Web__AllowedOrigins__2": "http://localhost:3019",
        "Identity__SeedAdminPassword": "Nexora-Local-2026!",
        "Identity__ResetSeedAdminPassword": "false"
      },
      "justMyCode": true,
      "presentation": {
        "hidden": true
      },
      "preLaunchTask": "local-build-api"
    },
    {
      "name": "Nexora internal CRM web",
      "type": "node",
      "request": "launch",
      "resolveSourceMapLocations": [
        "**",
        "!**/node_modules/**"
      ],
      "runtimeExecutable": "C:/Users/ramish/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node.exe",
      "program": "${workspaceFolder}/apps/web/node_modules/next/dist/bin/next",
      "cwd": "${workspaceFolder}/apps/web",
      "args": [
        "dev",
        "--webpack",
        "--port",
        "3017"
      ],
      "env": {
        "NEXORA_API_URL": "http://localhost:5097",
        "NEXORA_NEXT_DIST_DIR": ".next-local-debug-crm"
      },
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "serverReadyAction": {
        "action": "startDebugging",
        "name": "Nexora CRM Edge",
        "pattern": "- Local:\\s+(https?://\\S+)"
      },
      "presentation": {
        "hidden": true
      },
      "preLaunchTask": "local-ensure-api-crm"
    },
    {
      "name": "Nexora internal Portal web",
